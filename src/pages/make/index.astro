---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("make")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Make | The High Prairie"
  description="Handmade or 3D printed smoking accessories, crafts, and process pages."
>
  <h1>Make</h1>
  <p>Build logs, process pages, and practical object-making.</p>

  <ul class="listing">
    {
      entries.map((entry) => (
        <li>
          <a href={`/make/${entry.slug}`}>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <p class="meta">
              {entry.data.date.toLocaleDateString()}
              {entry.data.process ? " • Process" : ""}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .listing {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
</style>
