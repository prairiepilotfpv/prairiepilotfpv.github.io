---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("art")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Art | The High Prairie"
  description="Photo-centric artistic posts and visual work."
>
  <h1>Art</h1>
  <p>Visual-first work: photographs, studies, and image-led posts.</p>

  <ul class="listing">
    {
      entries.map((entry) => (
        <li>
          <a href={`/art/${entry.slug}`}>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            <p class="meta">{entry.data.date.toLocaleDateString()}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .listing {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    list-style: none;
    padding: 0;
  }

  li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
</style>
