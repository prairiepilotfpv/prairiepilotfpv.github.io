---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/index/Hero_banner.jpg";
import artBanner from "../assets/images/index/art_banner.jpg";
import wordsBanner from "../assets/images/index/writing_banner.jpg";
import makeBanner from "../assets/images/index/making_banner.jpg";
---

<BaseLayout
  title="The High Prairie"
  description="Editorial, visual, and making work across Art, Words, and Make."
>

  <section class="scroll-section section-hero section--viewport" aria-labelledby="hero-title">
    <div class="section-inner">
        <!-- hero image wrapper uses break‑out styles to span the viewport
             while keeping the surrounding text constrained to the centered
             column -->
        <div class="hero-wrapper">
          <Image
            src={heroImage}
            alt="Wide prairie under a summer sky"
            class="hero-photo"
            widths={[640, 1024, 1600]}
            sizes="(min-width: 760px) 100vw, 100vw"
            priority
          />
        </div>
      </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-art-title">
    <div class="section-inner">
      <div class="splash-media">
        <Image
          src={artBanner}
          alt="Art section preview"
          class="splash-banner"
          widths={[640, 768]}
          sizes="(min-width: 760px) 44rem, 90vw"
        />
        <div class="splash-overlay">
          <h1 id="splash-art-title">Art</h1>
          <p class="section-text">
            A visual-first section for photography, studies, and image-led publishing.
          </p>
          <p><a class="section-link" href="/art">Enter Art</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-words-title">
    <div class="section-inner">
      <div class="splash-media">
        <Image
          src={wordsBanner}
          alt="Words section preview"
          class="splash-banner"
          widths={[640, 768]}
          sizes="(min-width: 760px) 44rem, 90vw"
        />
        <div class="splash-overlay">
          <h1 id="splash-words-title">Words</h1>
          <p class="section-text">
            A text-led section for essays, notes, and longer editorial writing.
          </p>
          <p><a class="section-link" href="/words">Enter Words</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-make-title">
    <div class="section-inner">
      <div class="splash-media">
        <Image
          src={makeBanner}
          alt="Make section preview"
          class="splash-banner"
          widths={[640, 768]}
          sizes="(min-width: 760px) 44rem, 90vw"
        />
        <div class="splash-overlay">
          <h1 id="splash-make-title">Make</h1>
          <p class="section-text">
            A process-focused section for practical making, prototypes, and craft logs.
          </p>
          <p><a class="section-link" href="/make">Enter Make</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-section section-about" aria-labelledby="about-preview-title">
    <div class="section-inner">
      <h1 id="about-preview-title">About</h1>
      <p class="section-text">
        The High Prairie is a personal publishing project for visual work, writing, and
        practical making.
      </p>
      <p><a class="section-link" href="/about">Read About</a></p>
    </div>
  </section>
</BaseLayout>

<style>

.section--viewport {
    min-height: 85vh;
  }

  .section-inner {
    margin: 0 auto;
    max-width: 44rem;
    text-align: center;
  }

  .section-overview .section-inner {
    max-width: 64rem;
  }

  /* hero break‑out styles */
  .hero-wrapper {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    width: 100vw;
    height: 60vh; /* adjust as needed for visual balance */
    overflow: hidden;
  }

  .hero-photo {
    display: block;
    width: 100vw;
    max-width: 100vw;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .section-kicker {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-text {
    max-width: 40rem;
  }

  .hero-placeholder {
    align-items: center;
    background: var(--color-panel);
    border: 1px dashed var(--color-border);
    color: var(--color-muted);
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    min-height: 40vh;
    padding: 1rem;
  }

  .overview-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .overview-list li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .section-link {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25rem;
  }

  .section-splash .splash-media {
    margin-top: 2rem;
    position: relative;
  }

  .section-splash .splash-banner {
    border-radius: 4px;
    display: block;
    height: auto;
    width: 100%;
  }

  .section-splash .splash-overlay {
    align-items: center;
    background: linear-gradient(to top, rgb(0 0 0 / 78%), rgb(0 0 0 / 28%));
    border-radius: 4px;
    color: #fff;
    display: flex;
    flex-direction: column;
    inset: 0;
    justify-content: center;
    padding: 1.5rem;
    position: absolute;
    text-align: center;
  }

  .section-splash .splash-overlay .section-text {
    margin: 0.75rem auto 1rem;
  }

  .section-splash .splash-overlay .section-link {
    color: #fff;
  }

</style>
