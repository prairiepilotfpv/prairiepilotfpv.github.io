---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.getTime() - a.data.date.getTime();

const [artEntries, wordsEntries, makeEntries] = await Promise.all([
  getCollection("art").then((entries) => entries.sort(byNewest).slice(0, 2)),
  getCollection("words").then((entries) => entries.sort(byNewest).slice(0, 2)),
  getCollection("make").then((entries) => entries.sort(byNewest).slice(0, 2))
]);

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<BaseLayout
  title="The High Prairie"
  description="Editorial, visual, and making work across Art, Words, and Make."
>
  <header class="masthead">
    <p class="kicker">The High Prairie</p>
    <h1>A publishing ground for image, language, and craft.</h1>
    <p class="deck">
      Editorial work shaped by place: visual studies in Art, reflective essays in Words,
      and practical build logs in Make.
    </p>
    <nav class="mode-nav" aria-label="Publishing modes">
      <a href="/art">Art</a>
      <a href="/words">Words</a>
      <a href="/make">Make</a>
    </nav>
  </header>

  <section class="mode mode-art" aria-labelledby="home-art-heading">
    <div class="mode-header">
      <h2 id="home-art-heading"><a href="/art">Art</a></h2>
      <p>Visual work, photography, and image-led posts.</p>
    </div>
    <ul class="entry-list">
      {
        artEntries.map((entry) => (
          <li>
            <a href={`/art/${entry.slug}`}>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <p class="meta">{formatDate(entry.data.date)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mode mode-words" aria-labelledby="home-words-heading">
    <div class="mode-header">
      <h2 id="home-words-heading"><a href="/words">Words</a></h2>
      <p>Essays, notes, and text-led reflection.</p>
    </div>
    <ul class="entry-list">
      {
        wordsEntries.map((entry) => (
          <li>
            <a href={`/words/${entry.slug}`}>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.excerpt ?? entry.data.description}</p>
              <p class="meta">{formatDate(entry.data.date)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mode mode-make" aria-labelledby="home-make-heading">
    <div class="mode-header">
      <h2 id="home-make-heading"><a href="/make">Make</a></h2>
      <p>Handmade and 3D-printed accessories, tools, and process pages.</p>
    </div>
    <ul class="entry-list">
      {
        makeEntries.map((entry) => (
          <li>
            <a href={`/make/${entry.slug}`}>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <p class="meta">
                {formatDate(entry.data.date)}
                {entry.data.process ? " • Process log" : ""}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .masthead {
    border-left: 4px solid var(--color-ink);
    margin-bottom: 2.5rem;
    max-width: 52rem;
    padding-left: 1rem;
  }

  .kicker {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .deck {
    max-width: 44rem;
  }

  .mode-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .mode-nav a {
    border: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mode {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }

  .mode-header {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .mode-header h2 {
    margin-bottom: 0;
  }

  .mode-header h2 a {
    text-decoration: none;
  }

  .mode-header p {
    color: var(--color-muted);
    margin-bottom: 0;
    max-width: 36rem;
  }

  .entry-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry-list li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
  }

  .entry-list a {
    display: block;
    padding: 0.9rem 1rem;
    text-decoration: none;
  }

  .entry-list h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .entry-list p {
    margin-bottom: 0.45rem;
  }

  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  @media (min-width: 860px) {
    .entry-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
