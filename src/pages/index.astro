---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The High Prairie"
  description="Editorial, visual, and making work across Art, Words, and Make."
>
  <section class="scroll-section section-hero section--viewport" aria-labelledby="hero-title">
    <div class="section-inner">
      <p class="section-kicker">The High Prairie</p>
      <h1 id="hero-title">A long-form landing page for image, language, and craft.</h1>
      <p class="section-text">
        This hero is intentionally a placeholder for a future full-bleed photograph.
      </p>
      <div
        class="hero-placeholder"
        role="img"
        aria-label="Hero image placeholder for future homepage photography"
      >
        Photo placeholder
      </div>
    </div>
  </section>

  <section class="scroll-section section-overview" aria-labelledby="overview-title">
    <div class="section-inner">
      <h2 id="overview-title">Start with a page</h2>
      <ul class="overview-list">
        <li>
          <h3><a href="/art">Art</a></h3>
          <p>Visual work, photography, and image-led posts.</p>
        </li>
        <li>
          <h3><a href="/words">Words</a></h3>
          <p>Essays, reflections, and text-first publishing.</p>
        </li>
        <li>
          <h3><a href="/make">Make</a></h3>
          <p>Handmade and 3D-printed objects, process notes, and build logs.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-art-title">
    <div class="section-inner">
      <h2 id="splash-art-title">Art</h2>
      <p class="section-text">
        A visual-first section for photography, studies, and image-led publishing.
      </p>
      <p><a class="section-link" href="/art">Enter Art</a></p>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-words-title">
    <div class="section-inner">
      <h2 id="splash-words-title">Words</h2>
      <p class="section-text">
        A text-led section for essays, notes, and longer editorial writing.
      </p>
      <p><a class="section-link" href="/words">Enter Words</a></p>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-make-title">
    <div class="section-inner">
      <h2 id="splash-make-title">Make</h2>
      <p class="section-text">
        A process-focused section for practical making, prototypes, and craft logs.
      </p>
      <p><a class="section-link" href="/make">Enter Make</a></p>
    </div>
  </section>

  <section class="scroll-section section-about" aria-labelledby="about-preview-title">
    <div class="section-inner">
      <h2 id="about-preview-title">About</h2>
      <p class="section-text">
        The High Prairie is a personal publishing project for visual work, writing, and
        practical making.
      </p>
      <p><a class="section-link" href="/about">Read About</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .scroll-section {
    border-top: 1px solid var(--color-border);
    padding: 3rem 0;
  }

  .section--viewport {
    min-height: 85vh;
  }

  .section-inner {
    margin: 0 auto;
    max-width: 44rem;
    text-align: center;
  }

  .section-kicker {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-text {
    max-width: 40rem;
  }

  .hero-placeholder {
    align-items: center;
    background: var(--color-panel);
    border: 1px dashed var(--color-border);
    color: var(--color-muted);
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    min-height: 40vh;
    padding: 1rem;
  }

  .overview-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .overview-list li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .section-link {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25rem;
  }

  @media (min-width: 760px) {
    .overview-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
