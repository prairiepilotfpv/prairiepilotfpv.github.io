---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/index/Hero_banner.jpg";
---

<BaseLayout
  title="The High Prairie"
  description="Editorial, visual, and making work across Art, Words, and Make."
>
  <section class="scroll-section section-hero section--viewport" aria-labelledby="hero-title">
    <div class="section-inner">
        <!-- hero image wrapper uses break‑out styles to span the viewport
             while keeping the surrounding text constrained to the centered
             column -->
        <div class="hero-wrapper">
          <Image
            src={heroImage}
            alt="Wide prairie under a summer sky"
            class="hero-photo"
            widths={[640, 1024, 1600]}
            sizes="(min-width: 760px) 100vw, 100vw"
            placeholder="blur"
            fit="cover"
            aspectRatio={16 / 9}
            priority
          />
        </div>
      </div>
  </section>

  <section class="scroll-section section-overview" aria-labelledby="overview-title">
    <div class="section-inner">
      <h2 id="overview-title">What I do</h2>
      <ul class="overview-list">
        <li>
          <h3><a href="/art">Art</a></h3>
          <p>Landscapes, portraits, still life</p>
        </li>
        <li>
          <h3><a href="/words">Words</a></h3>
          <p>Blogs, essays, poetry</p>
        </li>
        <li>
          <h3><a href="/make">Make</a></h3>
          <p>3D printing, DIY, design</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-art-title">
    <div class="section-inner">
      <h2 id="splash-art-title">Art</h2>
      <p class="section-text">
        A visual-first section for photography, studies, and image-led publishing.
      </p>
      <p><a class="section-link" href="/art">Enter Art</a></p>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-words-title">
    <div class="section-inner">
      <h2 id="splash-words-title">Words</h2>
      <p class="section-text">
        A text-led section for essays, notes, and longer editorial writing.
      </p>
      <p><a class="section-link" href="/words">Enter Words</a></p>
    </div>
  </section>

  <section class="scroll-section section-splash section--viewport" aria-labelledby="splash-make-title">
    <div class="section-inner">
      <h2 id="splash-make-title">Make</h2>
      <p class="section-text">
        A process-focused section for practical making, prototypes, and craft logs.
      </p>
      <p><a class="section-link" href="/make">Enter Make</a></p>
    </div>
  </section>

  <section class="scroll-section section-about" aria-labelledby="about-preview-title">
    <div class="section-inner">
      <h2 id="about-preview-title">About</h2>
      <p class="section-text">
        The High Prairie is a personal publishing project for visual work, writing, and
        practical making.
      </p>
      <p><a class="section-link" href="/about">Read About</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .scroll-section {
    border-top: 1px solid var(--color-border);
    padding: 3rem 0;
  }

  .section--viewport {
    min-height: 85vh;
  }

  .section-inner {
    margin: 0 auto;
    max-width: 44rem;
    text-align: center;
  }

  .section-overview .section-inner {
    max-width: 64rem;
  }

  /* hero break‑out styles */
  .hero-wrapper {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    width: 100vw;
    height: 60vh; /* adjust as needed for visual balance */
    overflow: hidden;
  }

  .hero-photo {
    display: block;
    width: 100vw;
    max-width: 100vw;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .section-kicker {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-text {
    max-width: 40rem;
  }

  .hero-placeholder {
    align-items: center;
    background: var(--color-panel);
    border: 1px dashed var(--color-border);
    color: var(--color-muted);
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    min-height: 40vh;
    padding: 1rem;
  }

  .overview-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .overview-list li {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }

  .section-link {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25rem;
  }

</style>
