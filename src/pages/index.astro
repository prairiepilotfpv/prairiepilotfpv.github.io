---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The High Prairie"
  description="Editorial, visual, and making work across Art, Words, and Make."
>
  <section class="hero">
    <p class="kicker">The High Prairie</p>
    <h1>Media-forward publishing, grounded in craft.</h1>
    <p>
      A restrained home for photography, essays, and practical build logs.
      Explore by mode: visual work, writing, or making.
    </p>
  </section>

  <section class="sections">
    <article>
      <h2><a href="/art">Art</a></h2>
      <p>Photo-centric artistic posts and visual studies.</p>
    </article>
    <article>
      <h2><a href="/words">Words</a></h2>
      <p>Essays, blog posts, and reflections with an editorial reading rhythm.</p>
    </article>
    <article>
      <h2><a href="/make">Make</a></h2>
      <p>Handmade and 3D printed smoking accessories, builds, and process pages.</p>
    </article>
  </section>
</BaseLayout>

<style>
  .hero {
    border-left: 4px solid var(--color-ink);
    margin-bottom: 2rem;
    max-width: 52rem;
    padding-left: 1rem;
  }

  .kicker {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .sections {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  article {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }
</style>
