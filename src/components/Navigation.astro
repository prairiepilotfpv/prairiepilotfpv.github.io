---
const links = [
  { href: "/", label: "Home" },
  { href: "/art", label: "Art" },
  { href: "/words", label: "Words" },
  { href: "/make", label: "Make" },
  { href: "/about", label: "About" }
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<nav class="site-nav" aria-label="Main">
  <a class="site-title" href="/">The High Prairie</a>
  <ul>
    {
      links.map((link) => {
        const normalizedHref = link.href.replace(/\/+$/, "") || "/";
        const isActive = pathname === normalizedHref;
        return (
          <li>
            <a href={link.href} aria-current={isActive ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .site-nav {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    position: static;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    z-index: 50;
    background: color-mix(in srgb, var(--color-panel) 92%, transparent);
    border: 0;
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 0.4rem 1.2rem color-mix(in srgb, var(--color-ink) 12%, transparent);
    backdrop-filter: blur(6px);
  }

  .site-title {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a[aria-current="page"] {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 700px) {
    .site-nav {
      align-items: flex-start;
      flex-direction: column;
      width: 100vw;
    }

    ul {
      flex-wrap: wrap;
    }
  }
</style>
