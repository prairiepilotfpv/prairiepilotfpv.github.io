---
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The High Prairie" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Goudy+Bookletter+1911&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navigation />
    <div class="shell">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .shell {
    margin: 0 auto;
    max-width: 72rem;
    min-height: 100vh;
    padding: 0 1rem 3rem;
  }

  main {
    padding-top: 0;
  }
</style>
